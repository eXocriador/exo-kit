{
  "name": "@exo/kit",
  "version": "0.10.0",
  "description": "Shared mechanism for small self-hosted services: infra (postgres/redis/json), structured logging, a client for the exo-ai model service and an embedder, HTTP responses and rate limiting, session auth primitives and a Better Auth login that cannot be configured out of our policy, health probes, environment schemas, an error-reporting seam, transactional email and escalation notices, support-connector SDK, and the vendoring step that puts a block's SQL migrations where dbmate can read them. Factories only — the kit never reads process.env and never knows a product's name.",
  "license": "MIT",
  "author": "eXocriador",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eXocriador/exo-kit.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "migrations",
    "scripts/kit-migrations.mjs",
    "templates",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "bin": {
    "exo-kit-migrations": "./scripts/kit-migrations.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./infra": {
      "types": "./dist/infra/index.d.ts",
      "import": "./dist/infra/index.js"
    },
    "./json": {
      "types": "./dist/json/index.d.ts",
      "import": "./dist/json/index.js"
    },
    "./log": {
      "types": "./dist/log/index.d.ts",
      "import": "./dist/log/index.js"
    },
    "./llm": {
      "types": "./dist/llm/index.d.ts",
      "import": "./dist/llm/index.js"
    },
    "./ai": {
      "types": "./dist/ai/index.d.ts",
      "import": "./dist/ai/index.js"
    },
    "./health": {
      "types": "./dist/health/index.d.ts",
      "import": "./dist/health/index.js"
    },
    "./env": {
      "types": "./dist/env/index.d.ts",
      "import": "./dist/env/index.js"
    },
    "./telemetry": {
      "types": "./dist/telemetry/index.d.ts",
      "import": "./dist/telemetry/index.js"
    },
    "./http": {
      "types": "./dist/http/index.d.ts",
      "import": "./dist/http/index.js"
    },
    "./auth-core": {
      "types": "./dist/auth-core/index.d.ts",
      "import": "./dist/auth-core/index.js"
    },
    "./auth-core/cookie": {
      "types": "./dist/auth-core/cookie.d.ts",
      "import": "./dist/auth-core/cookie.js"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "import": "./dist/auth/index.js"
    },
    "./auth/migrations": {
      "types": "./dist/auth/migrations.d.ts",
      "import": "./dist/auth/migrations.js"
    },
    "./migrate": {
      "types": "./dist/migrate/index.d.ts",
      "import": "./dist/migrate/index.js"
    },
    "./mailer": {
      "types": "./dist/mailer/index.d.ts",
      "import": "./dist/mailer/index.js"
    },
    "./notify": {
      "types": "./dist/notify/index.d.ts",
      "import": "./dist/notify/index.js"
    },
    "./connector-sdk": {
      "types": "./dist/connector-sdk/index.d.ts",
      "import": "./dist/connector-sdk/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "scan": "gitleaks dir . --no-banner --redact"
  },
  "peerDependencies": {
    "better-auth": "1.7.4",
    "ioredis": ">=5",
    "pg": ">=8.16",
    "pino": ">=9",
    "postgres": ">=3.4",
    "zod": "^3.25 || ^4"
  },
  "peerDependenciesMeta": {
    "better-auth": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    },
    "pino": {
      "optional": true
    },
    "postgres": {
      "optional": true
    },
    "zod": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.7.4",
    "ioredis": "^5.11.0",
    "pg": "^8.16.3",
    "pino": "^9.14.0",
    "postgres": "^3.4.9",
    "typescript": "^5.7.0",
    "vitest": "^4.1.8",
    "zod": "^3.25.76"
  }
}
